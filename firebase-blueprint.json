{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User profile document with RBAC roles",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["Owner / Admin", "Student / Learner", "Creator"] },
        "creationsCount": { "type": "number" },
        "favoritesCount": { "type": "number" },
        "joinedDate": { "type": "string" },
        "provider": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "type": "object",
      "description": "User learning progress, studio sessions, and preferences",
      "properties": {
        "userId": { "type": "string" },
        "creditsRemaining": { "type": "number" },
        "totalGenerated": { "type": "number" },
        "level": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["userId"]
    },
    "Generation": {
      "title": "Generation",
      "type": "object",
      "description": "Artworks generated by users in Studio",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "prompt": { "type": "string" },
        "enhancedPrompt": { "type": "string" },
        "negativePrompt": { "type": "string" },
        "imageUrl": { "type": "string" },
        "style": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "quality": { "type": "string" },
        "status": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "likes": { "type": "number" },
        "views": { "type": "number" },
        "sourceType": { "type": "string" }
      },
      "required": ["id", "userId", "imageUrl", "prompt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with assigned RBAC role"
    },
    "/users/{userId}/progress/state": {
      "schema": "UserProgress",
      "description": "User activity progress and studio statistics"
    },
    "/users/{userId}/generations/{generationId}": {
      "schema": "Generation",
      "description": "Private user creations"
    },
    "/communityGenerations/{generationId}": {
      "schema": "Generation",
      "description": "Public community explore artworks"
    }
  }
}
