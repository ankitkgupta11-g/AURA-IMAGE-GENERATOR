# GEMINI_API_KEY: Required for Gemini AI API calls (prompt enhancement & image generation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL / Neon connection string (falls back to persistent local storage)
DATABASE_URL=""

# STORAGE_PROVIDER: "local" (default) or "s3" or "cloudinary"
STORAGE_PROVIDER="local"

# Clerk Authentication
# Obtain this from your Clerk Dashboard (https://dashboard.clerk.com) -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=""
# Optional Clerk Webhook Signing Secret for /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=""

