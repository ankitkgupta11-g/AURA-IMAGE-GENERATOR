rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has owner/admin email
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kajugupta1119@gmail.com' ||
        request.auth.token.email == 'ankitkgupta1123@gmail.com'
      );
    }

    // Users Collection: Zero-Trust personal user profiles
    match /users/{userId} {
      // User can read and update their own profile, SuperAdmin can view/manage
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();

      // User's private progress subcollection
      match /progress/{docId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // User's private generations subcollection
      match /generations/{genId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Community Public Artworks Collection
    match /communityGenerations/{genId} {
      // Any authenticated or guest user can view public community art
      allow read: if true;
      // Only the author or SuperAdmin can publish, update or delete
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isSuperAdmin() ||
        // Allow incrementing likes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }
  }
}
